m_all_de_genes <- unique(c(m_up_genes, m_down_genes))
m_down_genes <- unique(c(rownames(m_d4_vs_d1_down), rownames(m_d8_vs_d4_down), rownames(m_d11_vs_d8_down), rownames(m_d14_vs_d11_down)))
m_all_de_genes <- unique(c(m_up_genes, m_down_genes))
gene_annot <- data.frame(
Regulation = c(
rep("Up", length(m_up_genes)),
rep("Down", length(m_down_genes))
)
)
rownames(gene_annot) <- c(m_up_genes, m_down_genes)
data_mono <- read.table("Results/Normalized_data/B_cell/normalized_counts.txt", header = T, row.names = 1)
data_mono_filter <- data_mono[m_all_de_genes, ]
data_mono_filter <- data_mono_filter %>%
tibble::rownames_to_column("Gene")
df_long <- data_mono_filter %>%
pivot_longer(-Gene, names_to = "Sample", values_to = "Expression") %>%
mutate(
Day = str_extract(Sample, "D\\d+"),
Patient = str_extract(Sample, "p\\d+"),
Replicate = str_extract(Sample, "rep\\d+"),
Condition = sub(".*_(auto|b)$", "\\1", Sample)
)
# Function to average replicates for each group
df_avg <- df_long %>%
group_by(Gene, Day, Patient, Condition) %>%
summarise(MeanExpression = mean(Expression, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = c("Day", "Patient", "Condition"),
values_from = MeanExpression,
names_glue = "{Day}_{Patient}_{Condition}",
names_vary = "slowest"
) %>%
column_to_rownames("Gene") %>% as.matrix()
avg_expr <- as.data.frame(df_avg)
rownames(avg_expr) <- rownames(df_avg)
# Step 3: Build annotation dataframe for heatmap
annot <- data.frame(
Day = str_extract(colnames(avg_expr), "D\\d+"),
Patient = str_extract(colnames(avg_expr), "p\\d+"),
Condition = sub(".*_(auto|B)$", "\\1", colnames(avg_expr))
)
ann_colors <- list(
Regulation = c(Up = "firebrick", Down = "royalblue"),
Condition = c(auto = "#44AA99", B = "#E69F00"),
Patient = c(p1 = "#a6cee3", p2 = "#1f78b4", p3 = "#b2df8a"),
Day = c(D1 = "#c6cee3", D4 = "#d2df8a", D8 = "#fdbf6f", D11 = "#cab2d6", D14 = "#fb9a99")
)
day_levels <- c("D1", "D4", "D8", "D11", "D14")
annot$Day <- factor(annot$Day, levels = day_levels)
rownames(annot) <- colnames(avg_expr)
day_labels <- str_extract(colnames(avg_expr), "D\\d+")
order_idx <- order(factor(day_labels, levels = day_levels))
avg_expr <- avg_expr[, order_idx]
# Step 4: Build heatmap
pheatmap(
avg_expr,
annotation_col = annot,
annotation_row = gene_annot,
annotation_colors = ann_colors,
scale = "row",
cluster_rows = TRUE,
cluster_cols = FALSE,            # keep time order
show_colnames = TRUE,
border_color = NA,
fontsize = 10
)
