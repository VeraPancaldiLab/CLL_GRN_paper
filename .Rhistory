labs(
x = "Time (h)",
y = "Concentration (mg/L)",
title = "Cabozantinib PK: Individual Profiles, Mean, and ±SD Ribbon"
) +
theme_bw(base_size = 14)
code <- '
$PARAM
CL = 2.478,       /
Vc = 187,
Q  = 31.213,
Vp = 195.1,
KA = 0.979,
F1 = 0.8,
D1 = 0.1,
D2 = 0.2,
K0 = 0.3,
MT = 1.0
$CMT GUT1 GUT2 CENT PERIPH
$OMEGA 0.35 0.10 0.08 0.20 0.05
$SIGMA 0.10
$MAIN
double CLi = CL * exp(ETA(1));
double Vci = Vc * exp(ETA(2));
double Qi  = Q  * exp(ETA(3));
double Vpi = Vp * exp(ETA(4));
double KAi = KA * exp(ETA(5));
$ODE
dxdt_GUT1   = -KAi * GUT1;
dxdt_GUT2   = -K0;
dxdt_CENT   = KAi * GUT1 + K0 - (CLi/Vci) * CENT - (Qi/Vci) * CENT + (Qi/Vpi) * PERIPH;
dxdt_PERIPH = (Qi/Vci) * CENT - (Qi/Vpi) * PERIPH;
$TABLE
double CP = CENT / Vci;
double DV = exp(log(CP) + EPS(1));
$CAPTURE CP DV CLi Vci
'
mod <- mcode("cabozantinib_fixed", code)
code <- '
$PARAM
CL = 2.478,
Vc = 187,
Q  = 31.213,
Vp = 195.1,
KA = 0.979,
F1 = 0.8,
D1 = 0.1,
D2 = 0.2,
K0 = 0.3,
MT = 1.0
$CMT GUT1 GUT2 CENT PERIPH
$OMEGA 0.35 0.10 0.08 0.20 0.05
$SIGMA 0.10
$MAIN
double CLi = CL * exp(ETA(1));
double Vci = Vc * exp(ETA(2));
double Qi  = Q  * exp(ETA(3));
double Vpi = Vp * exp(ETA(4));
double KAi = KA * exp(ETA(5));
$ODE
dxdt_GUT1   = -KAi * GUT1;
dxdt_GUT2   = -K0;
dxdt_CENT   = KAi * GUT1 + K0 - (CLi/Vci) * CENT - (Qi/Vci) * CENT + (Qi/Vpi) * PERIPH;
dxdt_PERIPH = (Qi/Vci) * CENT - (Qi/Vpi) * PERIPH;
$TABLE
double CP = CENT / Vci;
double DV = exp(log(CP) + EPS(1));
$CAPTURE CP DV CLi Vci
'
mod <- mcode("cabozantinib_fixed", code)
n_subj <- 500
dose_amt <- 60  # e.g. 60 mg daily
dose_times <- seq(0, 48, by = 24)  # dosing at 0, 24, 48 h (3 doses)
# Sampling times (post dose) — e.g., 0.5, 1, 2, 4, 8, 24, 48 h
obs_times <- c(0.5, 1, 2, 4, 8, 24, 48)
# Build event table: dosing events + observation events
ev <- ev(amt = dose_amt, time = dose_times, cmt = "GUT1")  # put in GUT1
# Create a simulation grid
idata <- data.frame(ID = 1:n_subj)
out <- mod %>%
ev(ev) %>%
idata_set(idata) %>%
mrgsim(., end = max(dose_times) + max(obs_times), delta = 0.1)  # fine resolution
# explicitly coerce to data.frame then tibble
nsub <- 500
ev1 <- ev(amt = 60, cmt = 1, time = 0)
out <-
mod %>%
ev(ev1) %>%
mrgsim(end = 48, delta = 0.5, nid = nsub)
out <- as_tibble(as.data.frame(out))
# --- summarise across subjects ---
summary_df <- out %>%
group_by(time) %>%
summarise(
mean_CP = mean(CP, na.rm = TRUE),
sd_CP   = sd(CP, na.rm = TRUE),
.groups = "drop"
)
# --- ggplot2 visualization ---
ggplot() +
geom_line(data = out, aes(x = time, y = CP, group = ID),
color = "gray70", alpha = 0.4) +
geom_ribbon(data = summary_df,
aes(x = time, ymin = mean_CP - sd_CP, ymax = mean_CP + sd_CP),
fill = "skyblue", alpha = 0.4) +
geom_line(data = summary_df, aes(x = time, y = mean_CP),
color = "blue", size = 1.2) +
labs(
x = "Time (h)",
y = "Concentration (mg/L)",
title = "Cabozantinib PK: Individual Profiles, Mean, and ±SD Ribbon"
) +
theme_bw(base_size = 14)
deconv_data <- read.csv("Documents/Projects/CRCT/GRN_revision_deconvolution/output/Deconvolution_autologous.csv", header = T, row.names = 1)
View(deconv_data)
method = "CBSX_CBSX.Cadot_CLL.scRNAseq_"
x = deconv_autologous[,grep(method, colnames(deconv_autologous))]
deconv_autologous = deconv_data
x = deconv_autologous[,grep(method, colnames(deconv_autologous))]
#x = x[,-grep("BayesPrism_sigCLL_", colnames(x))]
x <- x %>%
tibble::rownames_to_column("SampleID")
# Parse metadata from SampleID
df_long <- x %>%
pivot_longer(-SampleID, names_to = "CellType", values_to = "Proportion") %>%
mutate(
Timepoint = str_extract(SampleID, "J\\d+"),
Timepoint = str_replace(Timepoint, "J", "D"),
Patient = str_extract(SampleID, "p\\d+"),
Replicate = str_extract(SampleID, "rep\\d+")
)
library(dplyr)
library(tidyr)
library(ggplot2)
library(stringr)
# Parse metadata from SampleID
df_long <- x %>%
pivot_longer(-SampleID, names_to = "CellType", values_to = "Proportion") %>%
mutate(
Timepoint = str_extract(SampleID, "J\\d+"),
Timepoint = str_replace(Timepoint, "J", "D"),
Patient = str_extract(SampleID, "p\\d+"),
Replicate = str_extract(SampleID, "rep\\d+")
)
# Order timepoints
df_long <- df_long %>%
mutate(Timepoint = factor(Timepoint, levels = rev(c("D1", "D4", "D8", "D11", "D14"))))
df_avg <- df_long %>%
group_by(Timepoint, Patient, CellType) %>%
summarise(MeanProportion = mean(Proportion, na.rm = TRUE), .groups = "drop")
# Plot
p = ggplot(df_avg, aes(x = Timepoint, y = MeanProportion, fill = CellType)) +
geom_bar(stat = "identity", position = "stack") +
geom_text(aes(label = sprintf("%.5f", MeanProportion)),
position = position_stack(vjust = 0.5),
size = 4, color = "black") +
facet_wrap(~ Patient, ncol = 1) +
coord_flip() +  # Horizontal bars
labs(title = "Deconvolution per timepoint (Replicates averaged)",
subtitle = "Autologous",
x = "Timepoint", y = "Proportion") +
scale_fill_brewer(palette = "Set3") +
theme_minimal(base_size = 12) +
theme(strip.text = element_text(face = "bold"),
axis.text.y = element_text(angle = 0, hjust = 1)) +
theme(legend.position="bottom", legend.direction="vertical")
p
# Plot
p = ggplot(df_avg, aes(x = Timepoint, y = MeanProportion, fill = CellType)) +
geom_bar(stat = "identity", position = "stack") +
