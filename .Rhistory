pheatmap(
avg_expr,
annotation_col = annot,
annotation_row = gene_annot,
annotation_colors = ann_colors,
scale = "row",
cluster_rows = TRUE,
cluster_cols = FALSE,
show_colnames = TRUE,
border_color = NA,
fontsize = 8
)
