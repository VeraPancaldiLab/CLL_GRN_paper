# Perform enrichment
gprofiler_plot <- function(gene_list,
custom.bg,
gprof_sources,
max_set_size,
min_set_size,
correction_method,
n_terms_per_db,
title){
gostres = gost(gene_list, organism = "hsapiens",
ordered_query = FALSE,
evcodes = TRUE,
correction_method = correction_method,
domain_scope = "annotated",
custom_bg = custom.bg,
sources = gprof_sources, exclude_iea = FALSE)
if(is.null(gostres)){
print(c("No significant enrichment results to display"))
} else {
gostres.df <- gostres$result
print(paste(nrow(gostres.df), "terms / pathways significantly enriched BEFORE filtering based on minimum / maximum gene set sizes", sep =" "))
gostres.df <- dplyr::filter(gostres$result, term_size <= max_set_size & term_size > min_set_size)
print(paste(nrow(gostres.df), "terms / pathways significantly enriched AFTER filtering based on minimum / maximum gene set sizes", sep =" "))
duplicated_levels <- duplicated(gostres.df$term_name)
gostres.df[duplicated_levels,]$term_name <- paste(gostres.df[duplicated_levels,]$source, gostres.df[duplicated_levels,]$term_name, sep ="_")
tmp <- as.data.frame(gostres.df %>%
dplyr::arrange(p_value) %>%
dplyr::group_by(source) %>% dplyr::slice(1:n_terms_per_db))
tmp$term_name <- factor(tmp$term_name, levels = fct_reorder(.f = rev(tmp$term_name), .x = rev(-log10(tmp$p_value))))
g <-  ggplot(tmp, aes(x = -log10(p_value),
y= term_name,
color = source,
size = recall)) +
geom_point() +
theme_bw() +
theme(legend.position = "bottom",
axis.title.y = element_blank(),
axis.text.y = element_text(size = 10)) +
labs( x = "-log10(pvalue)",
y = "",
size = "Ratio",
title = title) +
guides(colour = guide_legend(nrow = 1, order = 1, direction = "vertical", title.position = "top", hjust =1),
size = guide_legend(nrow = 1, order = 2, direction = "vertical", title.position = "top", hjust =-1)) +
scale_y_discrete(labels = label_wrap(width = 45))
print(g)
# png(filename = paste(Figures_dir, gsub(pattern = ".xlsx", replacement = ".png", output_file_name), sep ="/"), width = 300, height = 300, units = "cm", res = 300)
# g
# dev.off()
}
}
library(dplyr)
library(tidyverse)
library(pheatmap)
# Up genes
a_d4_vs_d1_up <- read.csv("Results/Differential_expression/Autologous/Auto_D4_vs_D1_up.csv", header = T, row.names = 1)
a_d8_vs_d4_up <- read.csv("Results/Differential_expression/Autologous/Auto_D8_vs_D4_up.csv", header = T, row.names = 1)
a_d11_vs_d8_up <- read.csv("Results/Differential_expression/Autologous/Auto_D11_vs_D8_up.csv", header = T, row.names = 1)
a_d14_vs_d11_up <- read.csv("Results/Differential_expression/Autologous/Auto_D14_vs_D11_up.csv", header = T, row.names = 1)
a_up_genes <- unique(c(rownames(a_d4_vs_d1_up), rownames(a_d8_vs_d4_up), rownames(a_d11_vs_d8_up), rownames(a_d14_vs_d11_up)))
# Down genes
a_d4_vs_d1_down <- read.csv("Results/Differential_expression/Autologous/Auto_D4_vs_D1_down.csv", header = T, row.names = 1)
a_d8_vs_d4_down <- read.csv("Results/Differential_expression/Autologous/Auto_D8_vs_D4_down.csv", header = T, row.names = 1)
a_d11_vs_d8_down <- read.csv("Results/Differential_expression/Autologous/Auto_D11_vs_D8_down.csv", header = T, row.names = 1)
a_d14_vs_d11_down <- read.csv("Results/Differential_expression/Autologous/Auto_D14_vs_D11_down.csv", header = T, row.names = 1)
a_down_genes <- unique(c(rownames(a_d4_vs_d1_down), rownames(a_d8_vs_d4_down), rownames(a_d11_vs_d8_down), rownames(a_d14_vs_d11_down)))
a_all_de_genes <- unique(c(a_up_genes, a_down_genes))
############# Monoculture condition ####################
# Up genes
m_d4_vs_d1_up <- read.csv("Results/Differential_expression/Monoculture/Mono_D4_vs_D1_up.csv", header = T, row.names = 1)
m_d8_vs_d4_up <- read.csv("Results/Differential_expression/Monoculture/Mono_D8_vs_D4_up.csv", header = T, row.names = 1)
m_d11_vs_d8_up <- read.csv("Results/Differential_expression/Monoculture/Mono_D11_vs_D8_up.csv", header = T, row.names = 1)
m_d14_vs_d11_up <- read.csv("Results/Differential_expression/Monoculture/Mono_D14_vs_D11_up.csv", header = T, row.names = 1)
m_up_genes <- unique(c(rownames(m_d4_vs_d1_up), rownames(m_d8_vs_d4_up), rownames(m_d11_vs_d8_up), rownames(m_d14_vs_d11_up)))
# Down genes
m_d4_vs_d1_down <- read.csv("Results/Differential_expression/Monoculture/Mono_D4_vs_D1_down.csv", header = T, row.names = 1)
m_d8_vs_d4_down <- read.csv("Results/Differential_expression/Monoculture/Mono_D8_vs_D4_down.csv", header = T, row.names = 1)
m_d11_vs_d8_down <- read.csv("Results/Differential_expression/Monoculture/Mono_D11_vs_D8_down.csv", header = T, row.names = 1)
m_d14_vs_d11_down <- read.csv("Results/Differential_expression/Monoculture/Mono_D14_vs_D11_down.csv", header = T, row.names = 1)
m_down_genes <- unique(c(rownames(m_d4_vs_d1_down), rownames(m_d8_vs_d4_down), rownames(m_d11_vs_d8_down), rownames(m_d14_vs_d11_down)))
m_all_de_genes <- unique(c(m_up_genes, m_down_genes))
data_mono <- read.table("Results/Normalized_data/B_cell/normalized_counts.txt", header = T, row.names = 1)
colnames(data_mono) <- gsub("B", "monoculture", colnames(data_mono))
data_auto <- read.table("Results/Normalized_data/Autologous/normalized_counts.txt", header = T, row.names = 1)
colnames(data_auto) <- gsub("auto", "autologous", colnames(data_auto))
# Combine DE gene lists
all_DE_genes <- unique(c(a_all_de_genes, m_all_de_genes))
# Build gene annotation dataframe
gene_annot <- data.frame(
Gene = c(a_up_genes, a_down_genes, m_up_genes, m_down_genes),
Condition = c(
rep("autologous", length(a_up_genes) + length(a_down_genes)),
rep("monoculture",    length(m_up_genes) + length(m_down_genes))
),
Regulation = c(
rep("Up",   length(a_up_genes)),
rep("Down", length(a_down_genes)),
rep("Up",   length(m_up_genes)),
rep("Down", length(m_down_genes))
),
stringsAsFactors = FALSE
)
# Make unique rownames while keeping duplicates (add index if needed)
rownames(gene_annot) <- make.unique(paste0(gene_annot$Gene, "_", gene_annot$Condition))
# Filter common genes
common_genes_auto_mono <- intersect(rownames(data_auto), rownames(data_mono))
data_auto_filter <- data_auto[common_genes_auto_mono, , drop = FALSE] %>% tidyr::drop_na()
data_mono_filter <- data_mono[common_genes_auto_mono, , drop = FALSE] %>% tidyr::drop_na()
combined_data <- cbind(data_auto_filter, data_mono_filter)
combined_data_filter <- combined_data[all_DE_genes, , drop = FALSE] %>% tidyr::drop_na()
combined_data_filter <- combined_data_filter %>% tibble::rownames_to_column("Gene")
# Long → averaged data
df_long <- combined_data_filter %>%
pivot_longer(-Gene, names_to = "Sample", values_to = "Expression") %>%
mutate(
Day = str_extract(Sample, "D\\d+"),
Patient = str_extract(Sample, "p\\d+"),
Replicate = str_extract(Sample, "rep\\d+"),
Condition = sub(".*_(autologous|monoculture)$", "\\1", Sample)
)
df_avg <- df_long %>%
group_by(Gene, Day, Patient, Condition) %>%
summarise(MeanExpression = mean(Expression, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(
names_from = c("Day", "Patient", "Condition"),
values_from = MeanExpression,
names_glue = "{Day}_{Patient}_{Condition}",
names_vary = "slowest"
) %>%
column_to_rownames("Gene") %>%
as.matrix()
avg_expr <- as.data.frame(df_avg)
rownames(avg_expr) <- rownames(df_avg)
# Column annotations
annot <- data.frame(
Day = str_extract(colnames(avg_expr), "D\\d+"),
Patient = str_extract(colnames(avg_expr), "p\\d+"),
Condition = sub(".*_(autologous|monoculture)$", "\\1", colnames(avg_expr))
)
# Order days and match annotation order to columns
day_levels <- c("D1", "D4", "D8", "D11", "D14")
annot$Day <- factor(annot$Day, levels = day_levels)
rownames(annot) <- colnames(avg_expr)
# Order columns by Condition → Day → Patient
annot <- annot %>%
arrange(Condition, Day, Patient)
avg_expr <- avg_expr[, rownames(annot)]  # reorder matrix columns accordingly
# Define color palettes
ann_colors <- list(
Regulation = c(Up = "firebrick", Down = "royalblue"),
Condition = c(autologous = "#44AA99", monoculture = "#E69F00"),
Patient = c(p1 = "#a6cee3", p2 = "#1f78b4", p3 = "#b2df8a"),
Day = c(D1 = "#c6cee3", D4 = "#d2df8a", D8 = "#fdbf6f", D11 = "#cab2d6", D14 = "#fb9a99")
)
# Align row annotation — keep only Condition & Regulation
gene_annot_subset <- gene_annot[gene_annot$Gene %in% rownames(avg_expr), c("Condition", "Regulation"), drop = FALSE]
rownames(gene_annot_subset) <- make.unique(rownames(gene_annot_subset))
# Drop unused color levels
ann_colors$Regulation <- ann_colors$Regulation[
names(ann_colors$Regulation) %in% unique(gene_annot_subset$Regulation)
]
ann_colors$Condition <- ann_colors$Condition[
names(ann_colors$Condition) %in% unique(gene_annot_subset$Condition)
]
# Plot heatmap
p_all <- pheatmap(
avg_expr,
annotation_col = annot,
annotation_row = gene_annot_subset,
annotation_colors = ann_colors,
scale = "row",
cluster_rows = TRUE,
cluster_cols = FALSE,
show_colnames = TRUE,
border_color = NA,
gaps_col = 15,
cutree_rows = 3,
fontsize = 8,
main = "Expression of DE genes over time and condition"
)
clusters <- cutree(p_all$tree_row, k = 3)
genes_cluster3 <- names(clusters[clusters == 3])
pathways_plot <- gprofiler_plot(genes_cluster3,
custom.bg = NULL,
gprof_sources = c("GO:BP", "REAC", "KEGG"),
max_set_size = 1000,
min_set_size = 10,
correction_method = 'fdr', n_terms_per_db = 10, title = "DE genes expressed in autologous culture specifically")
library(gprofiler2)
